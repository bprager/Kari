[Unit]
Description=Kari automatic weather pilot evidence and backup
After=kari-weather-pilot.service
ConditionPathExists=/var/lib/kari/weather-pilot/pilot.json
ConditionPathExists=!/var/lib/kari/weather-pilot/reports/final.json

[Service]
Type=oneshot
User=kari
Group=kari
WorkingDirectory=/opt/kari-weather-pilot
ExecStart=/opt/kari-weather-pilot/.venv/bin/python -m kari.pilot report --config /etc/kari-weather-pilot/config.yaml --state /var/lib/kari/weather-pilot/pilot.json --reports /var/lib/kari/weather-pilot/reports
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kari/weather-pilot
RestrictAddressFamilies=AF_UNIX
